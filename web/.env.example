# Copy to web/.env.local. Local values come from `npm run db:status` at the repo root.

# Supabase (local: http://127.0.0.1:54321; hosted: Project Settings → API, region ca-central-1)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Scoring service (scoring/), called server-to-server only
SCORING_SERVICE_URL=http://127.0.0.1:8000
SCORING_SERVICE_TOKEN=

# Coaching tips (Phase 3)
ANTHROPIC_API_KEY=
